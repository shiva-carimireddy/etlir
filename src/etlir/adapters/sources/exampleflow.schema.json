{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etlir.com/synthetic/exampleflow/v1/schema.json",
  "title": "ExampleFlow v1 synthetic source format",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "pipeline"],
  "properties": {
    "format": {
      "const": "exampleflow"
    },
    "version": {
      "const": "1.0"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "datasets", "steps"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dataset"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "kind", "format", "path", "fields"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["source", "target", "intermediate"]
        },
        "kind": {
          "enum": ["file", "table", "stream", "other"]
        },
        "format": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "nullable"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": ["string", "integer", "number", "boolean", "date", "timestamp", "decimal", "unknown"]
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/read_step"
        },
        {
          "$ref": "#/$defs/filter_step"
        },
        {
          "$ref": "#/$defs/derive_step"
        },
        {
          "$ref": "#/$defs/write_step"
        },
        {
          "$ref": "#/$defs/external_http_step"
        }
      ]
    },
    "read_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "dataset", "inputs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "read"
        },
        "dataset": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "filter_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "inputs", "condition"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "filter"
        },
        "inputs": {
          "$ref": "#/$defs/one_input"
        },
        "condition": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "derive_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "inputs", "assignments"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "derive"
        },
        "inputs": {
          "$ref": "#/$defs/one_input"
        },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "expression"],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "expression": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      }
    },
    "write_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "dataset", "inputs"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "write"
        },
        "dataset": {
          "$ref": "#/$defs/identifier"
        },
        "inputs": {
          "$ref": "#/$defs/one_input"
        }
      }
    },
    "external_http_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "inputs", "method", "url", "timeout_seconds"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "external_http"
        },
        "inputs": {
          "$ref": "#/$defs/one_input"
        },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    },
    "one_input": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/field_expression"
        },
        {
          "$ref": "#/$defs/literal_expression"
        },
        {
          "$ref": "#/$defs/binary_expression"
        }
      ]
    },
    "field_expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "const": "field"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "literal_expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data_type", "value"],
      "properties": {
        "kind": {
          "const": "literal"
        },
        "data_type": {
          "enum": ["string", "integer", "number", "boolean", "null"]
        },
        "value": {
          "type": ["string", "integer", "number", "boolean", "null"]
        }
      }
    },
    "binary_expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "operator", "left", "right"],
      "properties": {
        "kind": {
          "const": "binary"
        },
        "operator": {
          "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "add", "subtract", "multiply", "divide", "and", "or"]
        },
        "left": {
          "$ref": "#/$defs/expression"
        },
        "right": {
          "$ref": "#/$defs/expression"
        }
      }
    }
  }
}

