{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etlir.com/schemas/v0.1/evidence-bundle.schema.json",
  "title": "ETLIR Migration Evidence Bundle v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_version",
    "etlir_version",
    "run_id",
    "created_at",
    "status",
    "source",
    "target",
    "model_validation",
    "artifacts",
    "summary",
    "records",
    "diagnostics"
  ],
  "properties": {
    "evidence_version": {
      "const": "0.1.0"
    },
    "etlir_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{16}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["complete", "qualified", "blocked"]
    },
    "source": {
      "$ref": "#/$defs/adapter_run"
    },
    "target": {
      "$ref": "#/$defs/adapter_run"
    },
    "model_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "model_version"],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "model_version": {
          "type": ["string", "null"]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "https://etlir.com/schemas/v0.1/diagnostic.schema.json"
      }
    }
  },
  "$defs": {
    "adapter_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "adapter_version"],
      "properties": {
        "adapter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "adapter_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "media_type", "sha256"],
      "properties": {
        "role": {
          "enum": ["source", "model", "target"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_elements", "model_operations", "preserved", "approximated", "unsupported", "ambiguous", "manual", "blocked"],
      "properties": {
        "source_elements": {
          "type": "integer",
          "minimum": 0
        },
        "model_operations": {
          "type": "integer",
          "minimum": 0
        },
        "preserved": {
          "type": "integer",
          "minimum": 0
        },
        "approximated": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "manual": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "pointer"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        }
      }
    },
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "pointer"],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "pointer": {
          "type": "string"
        }
      }
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "locator"],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs", "model_ref", "target_refs", "disposition", "basis", "diagnostic_ids"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "model_ref": {
          "$ref": "#/$defs/model_ref"
        },
        "target_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_ref"
          }
        },
        "disposition": {
          "enum": ["preserved", "approximated", "unsupported", "ambiguous", "manual", "blocked"]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "diagnostic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^diag_[a-f0-9]{12}$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}

